<?xml version="1.0" encoding="utf-8"?>
<!-- Brightness popout (tablet): matches JS brightness-slider-popup layout at ~1.5x scale.
     Horizontal row: left column (slider + step controls) | theme toggle button.
     Wrapped in a HorizontalScrollView so small-portrait screens can swipe to reach the
     theme toggle when the popout is wider than the screen. -->
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sidebar_popout"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="380dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp"
        android:gravity="center_vertical">

        <!-- Left column: slider on top, step controls below -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Slider track -->
            <SeekBar
                android:id="@+id/brightnessSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="10"
                android:progress="5"
                android:progressTint="@color/dashie_orange"
                android:thumbTint="@color/dashie_orange"
                android:layout_marginBottom="14dp" />

            <!-- Step controls: [-] [7] [+] centered -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <!-- Minus button (orange filled circle, white icon) -->
                <TextView
                    android:id="@+id/brightnessBtnMinus"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="−"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:gravity="center"
                    android:background="@drawable/bg_popout_circle_btn_orange"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- Level number -->
                <TextView
                    android:id="@+id/brightnessLevel"
                    android:layout_width="44dp"
                    android:layout_height="wrap_content"
                    android:text="5"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:gravity="center" />

                <!-- Plus button (orange filled circle, white icon) -->
                <TextView
                    android:id="@+id/brightnessBtnPlus"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="+"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:gravity="center"
                    android:background="@drawable/bg_popout_circle_btn_orange"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

        </LinearLayout>

        <!-- Theme toggle button (icon + stacked text, rounded box) -->
        <LinearLayout
            android:id="@+id/brightnessBtnDarkMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:minWidth="80dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_popout_rounded_btn"
            android:clickable="true"
            android:focusable="true">

            <!-- Theme icon -->
            <ImageView
                android:id="@+id/brightnessDarkModeIcon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_light_dark_mode"
                android:contentDescription="Theme" />

            <!-- "Switch to" label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Switch to"
                android:textColor="#99FFFFFF"
                android:textSize="11sp"
                android:layout_marginTop="4dp" />

            <!-- Dark/Light label -->
            <TextView
                android:id="@+id/brightnessDarkModeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dark"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</HorizontalScrollView>
