<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Centered white card -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/card_rounded_white"
        android:paddingStart="64dp"
        android:paddingEnd="64dp"
        android:paddingTop="48dp"
        android:paddingBottom="48dp"
        android:minWidth="400dp">

        <!-- Dashie Logo -->
        <ImageView
            android:id="@+id/dashieLogo"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:src="@drawable/dashie_full_logo"
            android:contentDescription="@string/brand_name"
            android:layout_marginBottom="28dp" />

        <!-- Title -->
        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connect to WiFi"
            android:textSize="26sp"
            android:textColor="#424242"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/subtitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Internet connection required to continue"
            android:textSize="15sp"
            android:textColor="#757575"
            android:gravity="center"
            android:layout_marginBottom="28dp" />

        <!-- Reconnecting spinner — shown during the boot reconnect grace period -->
        <ProgressBar
            android:id="@+id/reconnectingSpinner"
            style="?android:attr/progressBarStyle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="20dp"
            android:visibility="gone"
            android:indeterminateTint="#FF9800" />

        <!-- Connect Button -->
        <Button
            android:id="@+id/connectButton"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:text="Connect to WiFi"
            android:textSize="17sp"
            android:textColor="#ffffff"
            android:textAllCaps="false"
            android:background="@drawable/button_orange"
            android:paddingStart="48dp"
            android:paddingEnd="48dp"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <!-- Offline bypass, or Cancel in forceShow mode — text is set in
             WifiSetupActivity because it takes brand_name as a format argument. -->
        <Button
            android:id="@+id/useOfflineButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:textSize="14sp"
            android:textColor="#ffffff"
            android:textAllCaps="false"
            android:background="@drawable/button_gray"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:layout_marginTop="14dp"
            android:focusable="true" />

    </LinearLayout>

</FrameLayout>
