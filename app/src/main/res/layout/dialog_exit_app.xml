<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_background"
    android:padding="24dp">

    <!-- Title -->
    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Exit"
        android:textSize="20sp"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- Message -->
    <TextView
        android:id="@+id/dialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Signed in as user@example.com"
        android:textSize="15sp"
        android:textColor="@color/text_secondary"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="24dp" />

    <!-- 3-Button Row: Cancel | Logout | Exit App -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Cancel (left, border) -->
        <android.widget.Button
            android:id="@+id/buttonCancel"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Cancel"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:textAllCaps="false"
            android:background="@drawable/button_border"
            android:defaultFocusHighlightEnabled="false"
            android:nextFocusUp="@id/buttonCancel"
            android:nextFocusDown="@id/buttonCancel"
            android:layout_marginEnd="6dp" />

        <!-- Logout (center, border) -->
        <android.widget.Button
            android:id="@+id/buttonExit"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Logout"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:textAllCaps="false"
            android:background="@drawable/button_border"
            android:defaultFocusHighlightEnabled="false"
            android:nextFocusUp="@id/buttonExit"
            android:nextFocusDown="@id/buttonExit"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp" />

        <!-- Exit App (right, orange/primary) -->
        <android.widget.Button
            android:id="@+id/buttonLogout"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Exit App"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:background="@drawable/button_primary"
            android:defaultFocusHighlightEnabled="false"
            android:nextFocusUp="@id/buttonLogout"
            android:nextFocusDown="@id/buttonLogout"
            android:layout_marginStart="6dp" />

    </LinearLayout>

</LinearLayout>
