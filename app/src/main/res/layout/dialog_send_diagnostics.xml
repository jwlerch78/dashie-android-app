<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_background"
    android:padding="24dp">

    <!-- Title (fixed at top) -->
    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Send Diagnostics"
        android:textSize="20sp"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <!-- Scrollable content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Subtitle -->
            <TextView
                android:id="@+id/dialogSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <!-- Event count -->
            <TextView
                android:id="@+id/textEventCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0 events in buffer"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <!-- Scrollable Preview (nested scroll) -->
            <ScrollView
                android:id="@+id/scrollDiagnosticsPreview"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="@drawable/edit_text_background"
                android:padding="12dp"
                android:layout_marginBottom="16dp"
                android:nestedScrollingEnabled="true">

                <TextView
                    android:id="@+id/textDiagnosticsPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No diagnostic events yet"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="2dp" />

            </ScrollView>

            <!-- Privacy note -->
            <TextView
                android:id="@+id/textPrivacyNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Data is anonymized and only includes app diagnostic events. No personal information is collected."
                android:textSize="11sp"
                android:textColor="@color/text_hint"
                android:gravity="center" />

        </LinearLayout>

    </ScrollView>

    <!-- Buttons Row (fixed at bottom) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <!-- Close Button -->
        <Button
            android:id="@+id/buttonClose"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Close"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:textAllCaps="false"
            android:background="@drawable/button_border"
            android:layout_marginEnd="4dp" />

        <!-- Copy Button -->
        <Button
            android:id="@+id/buttonCopy"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Copy"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:textAllCaps="false"
            android:background="@drawable/button_border"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp" />

        <!-- Send Button -->
        <Button
            android:id="@+id/buttonSend"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Send"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:background="@drawable/button_primary"
            android:layout_marginStart="4dp" />

    </LinearLayout>

</LinearLayout>
