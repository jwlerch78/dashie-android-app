<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_background"
    android:padding="20dp">

    <!-- Title (fixed at top) -->
    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Screensaver Settings"
        android:textSize="18sp"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- Scrollable content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <!-- Two-column layout: Timeout on left (1/3), Screensaver Options on right (2/3) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Timeout column (1/3 width) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Timeout"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <RadioGroup
                    android:id="@+id/radioGroupTimeout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Custom input row (shown when Custom is selected) -->
                <LinearLayout
                    android:id="@+id/customInputContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:visibility="gone"
                    android:layout_marginTop="8dp">

                    <EditText
                        android:id="@+id/editCustomTimeout"
                        android:layout_width="60dp"
                        android:layout_height="40dp"
                        android:inputType="number"
                        android:gravity="center"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/edit_text_background"
                        android:padding="8dp"
                        android:maxLength="4" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="seconds"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginStart="8dp" />

                </LinearLayout>

                <!-- Keep Screen On toggle (shown only when timeout is "Off") -->
                <LinearLayout
                    android:id="@+id/rowKeepScreenOn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="6dp"
                    android:visibility="gone"
                    android:layout_marginTop="12dp"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Keep Screen On"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary" />

                    <Switch
                        android:id="@+id/switchKeepScreenOn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumbTint="@color/switch_thumb_color"
                        android:trackTint="@color/switch_track_color" />

                </LinearLayout>

                <!-- Hint text below Keep Screen On toggle -->
                <TextView
                    android:id="@+id/textKeepScreenOnHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Prevents screen from sleeping"
                    android:textSize="11sp"
                    android:textColor="@color/text_hint"
                    android:paddingStart="0dp"
                    android:layout_marginBottom="4dp"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Screensaver Options column (2/3 width) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Screensaver Options"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <!-- Show clock toggle (at top) -->
                <LinearLayout
                    android:id="@+id/rowShowClock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="6dp"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Show Clock"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary" />

                    <Switch
                        android:id="@+id/switchShowClock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumbTint="@color/switch_thumb_color"
                        android:trackTint="@color/switch_track_color" />

                </LinearLayout>

                <!-- Show Music Player toggle -->
                <LinearLayout
                    android:id="@+id/rowShowMusicPlayer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="6dp"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Show Music Player"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary" />

                    <Switch
                        android:id="@+id/switchShowMusicPlayer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumbTint="@color/switch_thumb_color"
                        android:trackTint="@color/switch_track_color" />

                </LinearLayout>

                <!-- Weather Overlay toggle -->
                <LinearLayout
                    android:id="@+id/rowWeatherOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="6dp"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Weather Overlay"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary" />

                    <Switch
                        android:id="@+id/switchWeatherOverlay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumbTint="@color/switch_thumb_color"
                        android:trackTint="@color/switch_track_color" />

                </LinearLayout>

                <!-- Weather entity ID (indented under Weather Overlay) -->
                <LinearLayout
                    android:id="@+id/rowWeatherEntity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="6dp"
                    android:paddingStart="16dp"
                    android:visibility="gone"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Weather Entity"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/textWeatherEntityValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary" />

                </LinearLayout>

                <!-- 24-hour format toggle (indented under Show Clock) -->
                <LinearLayout
                    android:id="@+id/rowUse24HourClock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="6dp"
                    android:paddingStart="16dp"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="24-hour format"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary" />

                    <Switch
                        android:id="@+id/switchUse24HourClock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumbTint="@color/switch_thumb_color"
                        android:trackTint="@color/switch_track_color" />

                </LinearLayout>

                <!-- Screensaver Mode row (clickable dropdown) -->
                <LinearLayout
                    android:id="@+id/rowMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="6dp"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Screensaver Mode:"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/textModeValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Dim"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"
                        android:gravity="end"
                        android:layout_marginStart="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textSize="16sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginStart="4dp" />

                </LinearLayout>

                <!-- Dim brightness options (shown when Dim mode is selected) -->
                <LinearLayout
                    android:id="@+id/dimBrightnessContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:paddingTop="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dim Level"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <SeekBar
                            android:id="@+id/seekBarDimBrightness"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:min="1"
                            android:max="75"
                            android:progress="15"
                            android:thumbTint="@color/dashie_orange"
                            android:progressTint="@color/dashie_orange"
                            android:progressBackgroundTint="@color/divider" />

                        <TextView
                            android:id="@+id/textDimBrightnessValue"
                            android:layout_width="44dp"
                            android:layout_height="wrap_content"
                            android:text="15%"
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary"
                            android:gravity="end"
                            android:layout_marginStart="12dp" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Lower = darker (1-75%, default: 15%)"
                        android:textSize="11sp"
                        android:textColor="@color/text_hint"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

                <!-- Photo options (shown when Photos mode is selected) - NOT indented -->
                <LinearLayout
                    android:id="@+id/photoSourceContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Photo Folder row (clickable) -->
                    <LinearLayout
                        android:id="@+id/rowPhotoSource"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="6dp"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Photo Folder"
                            android:textSize="14sp"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:id="@+id/textPhotoSourceValue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="All"
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary"
                            android:gravity="end"
                            android:ellipsize="middle"
                            android:singleLine="true"
                            android:layout_marginStart="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textSize="16sp"
                            android:textColor="@color/text_secondary"
                            android:layout_marginStart="4dp" />

                    </LinearLayout>

                    <!-- Photo folder/source info (shows folder for HA Media, status for others) -->
                    <TextView
                        android:id="@+id/textPhotoSourceInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:textColor="@color/text_secondary"
                        android:paddingStart="0dp"
                        android:layout_marginBottom="4dp"
                        android:visibility="gone" />

                    <!-- Duration row (clickable) -->
                    <LinearLayout
                        android:id="@+id/rowPhotoDuration"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="6dp"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Duration"
                            android:textSize="14sp"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:id="@+id/textPhotoDurationValue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="15 sec"
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary"
                            android:gravity="end"
                            android:layout_marginStart="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textSize="16sp"
                            android:textColor="@color/text_secondary"
                            android:layout_marginStart="4dp" />

                    </LinearLayout>

                    <!-- Show metadata toggle -->
                    <LinearLayout
                        android:id="@+id/rowShowMetadata"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="6dp"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Show Date, Location"
                            android:textSize="14sp"
                            android:textColor="@color/text_primary" />

                        <Switch
                            android:id="@+id/switchShowMetadata"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:thumbTint="@color/switch_thumb_color"
                            android:trackTint="@color/switch_track_color" />

                    </LinearLayout>

                </LinearLayout>

                <!-- URL options (shown when URL mode is selected) -->
                <LinearLayout
                    android:id="@+id/urlOptionsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- URL input row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingVertical="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Screensaver URL"
                            android:textSize="14sp"
                            android:textColor="@color/text_primary" />

                        <EditText
                            android:id="@+id/editScreensaverUrl"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:inputType="textUri"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:hint="@string/default_screensaver_url"
                            android:background="@drawable/edit_text_background"
                            android:padding="10dp"
                            android:layout_marginTop="4dp"
                            android:singleLine="true" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Default shows clock + weather. Try other URLs like flip clocks or ambient displays."
                            android:textSize="11sp"
                            android:textColor="@color/text_hint"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- App options (shown when App mode is selected) -->
                <LinearLayout
                    android:id="@+id/appOptionsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- App selection row (clickable) -->
                    <LinearLayout
                        android:id="@+id/rowSelectApp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="6dp"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="App to Launch"
                            android:textSize="14sp"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:id="@+id/textSelectedAppValue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Not configured"
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary"
                            android:gravity="end"
                            android:ellipsize="middle"
                            android:singleLine="true"
                            android:layout_marginStart="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textSize="16sp"
                            android:textColor="@color/text_secondary"
                            android:layout_marginStart="4dp" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Select an app to launch as screensaver (e.g., Immich Kiosk, Fotoo)"
                        android:textSize="11sp"
                        android:textColor="@color/text_hint"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

                <!-- Hidden RadioGroup for mode (used for compatibility, not displayed) -->
                <RadioGroup
                    android:id="@+id/radioGroupMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Button row (fixed at bottom) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="20dp">

        <Button
            android:id="@+id/buttonCancel"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="80dp"
            android:text="Cancel"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:textAllCaps="false"
            android:background="@drawable/button_border"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/buttonSave"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="80dp"
            android:text="Save"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:background="@drawable/button_primary" />

    </LinearLayout>

</LinearLayout>
