<?xml version="1.0" encoding="utf-8"?>
<!-- Feature card: [status dot] [label + summary] [chevron]
     Matches CSS .cc-card: 44dp height, 10dp horizontal padding, 8dp gap -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_cc_card"
    android:clickable="true"
    android:focusable="true">

    <!-- Status dot — 10dp circle, matches CSS .cc-dot -->
    <View
        android:id="@+id/ccDot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_cc_dot_off" />

    <!-- Label + Summary column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/ccCardLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/settings_text_label"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Voice &amp; AI" />

        <TextView
            android:id="@+id/ccCardSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/settings_text_value"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="1dp"
            tools:text="Hey Dashie v3.15S, HA Assist" />

    </LinearLayout>

    <!-- Chevron -->
    <TextView
        android:id="@+id/ccChevron"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="›"
        android:textColor="@color/settings_text_value"
        android:textSize="17sp" />

</LinearLayout>
