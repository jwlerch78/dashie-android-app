<?xml version="1.0" encoding="utf-8"?>
<!-- Advanced settings dialog - display, performance, battery optimization, WiFi lock, auto-reload -->
<!-- Note: maxHeight is set programmatically to 80% of screen height for smaller screens -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialogContainer"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_background"
    android:padding="20dp">

    <!-- Title -->
    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Advanced"
        android:textSize="18sp"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- Scrollable content area for smaller screens -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical"
        android:fadeScrollbars="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ==================== DISPLAY SECTION ==================== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DISPLAY"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp" />

            <!-- Zoom Row -->
            <LinearLayout
                android:id="@+id/rowZoom"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Dashboard Zoom"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/textZoomValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100%"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textSize="18sp"
                        android:textColor="@color/text_disabled" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Zoom in or out to fit your screen"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:background="@color/sidebar_divider_light" />

            <!-- Hardware Screen Off Toggle -->
            <LinearLayout
                android:id="@+id/rowHardwareScreenOff"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Hardware Screen Off"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary" />

                    <Switch
                        android:id="@+id/switchHardwareScreenOff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:thumbTint="@color/switch_thumb_color"
                        android:trackTint="@color/switch_track_color" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Turns display completely off instead of black overlay"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- Section Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="@color/sidebar_divider_light" />

            <!-- ==================== PERFORMANCE SECTION ==================== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PERFORMANCE"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp" />

            <!-- Battery Optimization Exemption Row (Toggle) -->
            <LinearLayout
                android:id="@+id/rowBatteryOptimization"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Battery Optimization Exemption"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary" />

                    <Switch
                        android:id="@+id/switchBatteryExemption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:thumbTint="@color/switch_thumb_color"
                        android:trackTint="@color/switch_track_color" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Prevents connection drops when idle"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:background="@color/sidebar_divider_light" />

            <!-- WiFi Lock Row -->
            <LinearLayout
                android:id="@+id/rowWifiLock"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Keep WiFi Awake"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary" />

                    <Switch
                        android:id="@+id/switchWifiLock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:thumbTint="@color/switch_thumb_color"
                        android:trackTint="@color/switch_track_color" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Maintains WiFi when screen is off"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:background="@color/sidebar_divider_light" />

            <!-- WebSocket Ping Row -->
            <LinearLayout
                android:id="@+id/rowWebsocketPing"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="WebSocket Keep-Alive"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary" />

                    <Switch
                        android:id="@+id/switchWebsocketPing"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:thumbTint="@color/switch_thumb_color"
                        android:trackTint="@color/switch_track_color" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sends pings to prevent connection drops"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- Divider for Auto-Reload (hidden when Keep-Alive is off) -->
            <View
                android:id="@+id/dividerAutoReload"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:background="@color/sidebar_divider_light"
                android:visibility="gone" />

            <!-- Auto-Reload Row (hidden when Keep-Alive is off) -->
            <LinearLayout
                android:id="@+id/rowAutoReload"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Auto-Reload on HA Idle"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/textAutoReloadValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3 min"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textSize="18sp"
                        android:textColor="@color/text_disabled" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Reloads page if no updates received"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- Divider after Auto-Reload (hidden when Auto-Reload is hidden) -->
            <View
                android:id="@+id/dividerAfterAutoReload"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:background="@color/sidebar_divider_light"
                android:visibility="gone" />

            <!-- Divider before Smart Reconnect -->
            <View
                android:id="@+id/dividerSmartReconnect"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:background="@color/sidebar_divider_light" />

            <!-- Smart Reconnect Row -->
            <LinearLayout
                android:id="@+id/rowSmartReconnect"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Smart Reconnect"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary" />

                    <Switch
                        android:id="@+id/switchSmartReconnect"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:thumbTint="@color/switch_thumb_color"
                        android:trackTint="@color/switch_track_color" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pauses during HA reboots to prevent IP ban"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- Local HA URL Row (hidden when Smart Reconnect is off) -->
            <LinearLayout
                android:id="@+id/rowLocalHaUrl"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Local HA URL"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/textLocalHaUrl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Not set"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginEnd="4dp"
                        android:maxWidth="120dp"
                        android:ellipsize="middle"
                        android:singleLine="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textSize="18sp"
                        android:textColor="@color/text_disabled" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Direct URL for ping check (e.g. http://192.168.1.x:8123)"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- Divider before Low Bandwidth Mode -->
            <View
                android:id="@+id/dividerLowBandwidth"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:background="@color/sidebar_divider_light" />

            <!-- Low Bandwidth Mode Row -->
            <LinearLayout
                android:id="@+id/rowLowBandwidth"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Low Bandwidth Mode"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary" />

                    <Switch
                        android:id="@+id/switchLowBandwidth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:thumbTint="@color/switch_thumb_color"
                        android:trackTint="@color/switch_track_color" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Hides video controls on camera cards"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- Prioritize Touch Row (hidden - feature not providing visible benefit, pending more data) -->
            <LinearLayout
                android:id="@+id/rowPrioritizeTouch"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Prioritize Touch Inputs"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary" />

                    <Switch
                        android:id="@+id/switchPrioritizeTouch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:thumbTint="@color/switch_thumb_color"
                        android:trackTint="@color/switch_track_color" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Delays updates during touch/d-pad interaction"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- ==================== DIAGNOSTICS SECTION ==================== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DIAGNOSTICS"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <!-- WebView API Logging Row -->
            <LinearLayout
                android:id="@+id/rowLogWebViewApiRequests"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Log WebView API Requests"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary" />

                    <Switch
                        android:id="@+id/switchLogWebViewApiRequests"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:thumbTint="@color/switch_thumb_color"
                        android:trackTint="@color/switch_track_color" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Records /api/ requests to diagnostic buffer"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- System Details button (inside scroll area) -->
            <Button
                android:id="@+id/buttonSystemDetails"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:text="Show System Details"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:textAllCaps="false"
                android:background="?android:attr/selectableItemBackground"
                android:layout_marginTop="12dp" />

            <!-- Open Android Settings button -->
            <Button
                android:id="@+id/buttonAndroidSettings"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:text="Open Android Settings"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:textAllCaps="false"
                android:background="?android:attr/selectableItemBackground"
                android:layout_marginTop="8dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Close button (fixed at bottom, outside scroll area) -->
    <Button
        android:id="@+id/buttonClose"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="Close"
        android:textSize="14sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:background="@drawable/button_primary"
        android:layout_marginTop="12dp" />

</LinearLayout>
