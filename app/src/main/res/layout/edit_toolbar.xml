<?xml version="1.0" encoding="utf-8"?>
<!-- Edit mode toolbar — replaces native sidebar during layout editing.
     Same dimensions/styling as sidebar_strip.xml panel. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/editToolbarRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone"
    android:clickable="false"
    android:focusable="false">

    <!-- The actual toolbar panel (matches sidebarStripPanel dimensions) -->
    <LinearLayout
        android:id="@+id/editToolbarPanel"
        android:layout_width="69dp"
        android:layout_height="match_parent"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/bg_sidebar_strip"
        android:elevation="8dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <!-- Close (top) -->
        <LinearLayout
            android:id="@+id/editBtnClose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/bg_sidebar_button"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="8dp"
            android:paddingBottom="6dp">
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_close"
                android:contentDescription="Close" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Close"
                android:textSize="12sp"
                android:textColor="#99FFFFFF"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <!-- Spacer pushes remaining items to bottom -->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Add Widget -->
        <LinearLayout
            android:id="@+id/editBtnAdd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/bg_sidebar_button"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="8dp"
            android:paddingBottom="6dp">
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_add"
                android:contentDescription="Add Widget" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add\nWidget"
                android:textSize="12sp"
                android:textColor="#99FFFFFF"
                android:gravity="center"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <!-- Undo -->
        <LinearLayout
            android:id="@+id/editBtnUndo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/bg_sidebar_button"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="8dp"
            android:paddingBottom="6dp"
            android:layout_marginTop="10dp">
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_edit_undo"
                android:contentDescription="Undo" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Undo"
                android:textSize="12sp"
                android:textColor="#99FFFFFF"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <!-- Grid Toggle -->
        <LinearLayout
            android:id="@+id/editBtnGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/bg_sidebar_button"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="8dp"
            android:paddingBottom="6dp"
            android:layout_marginTop="10dp">
            <ImageView
                android:id="@+id/editBtnGridIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_edit_grid"
                android:contentDescription="Toggle Grid" />
            <TextView
                android:id="@+id/editBtnGridLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Grid"
                android:textSize="12sp"
                android:textColor="#99FFFFFF"
                android:gravity="center"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="40dp"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="#33FFFFFF" />

        <!-- Save (bottom) -->
        <LinearLayout
            android:id="@+id/editBtnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/bg_sidebar_button"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="8dp"
            android:paddingBottom="6dp">
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_edit_save"
                android:contentDescription="Save" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Save"
                android:textSize="12sp"
                android:textColor="#99FFFFFF"
                android:layout_marginTop="3dp" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
