<?xml version="1.0" encoding="utf-8"?>
<!-- Timer Card - Expanded View
     Matches HTML design from kiosk-overlay/css/timer.css
     390px width, header + body layout -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="14dp"
    android:paddingTop="14dp">

    <!-- Main card content -->
    <LinearLayout
        android:id="@+id/timer_card_content"
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:elevation="12dp"
        android:outlineProvider="bounds">

        <!-- Header: Label + Controls -->
        <LinearLayout
            android:id="@+id/timer_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="28dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:gravity="center_vertical">

            <!-- Timer Name (or description if named timer) -->
            <TextView
                android:id="@+id/timer_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TIMER 1"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#B0B0B0"
                android:letterSpacing="0.05"
                android:ellipsize="end"
                android:maxLines="1" />

            <!-- Minimize Button -->
            <ImageButton
                android:id="@+id/timer_minimize"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_minimize"
                android:contentDescription="Minimize"
                android:padding="6dp"
                android:scaleType="fitCenter" />
        </LinearLayout>

        <!-- Body: Time + Controls (Horizontal Layout) -->
        <LinearLayout
            android:id="@+id/timer_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="12dp"
            android:gravity="center_vertical">

        <!-- Large Time Display -->
        <TextView
            android:id="@+id/timer_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="5:00"
            android:textSize="54sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:fontFeatureSettings="tnum" />

        <!-- Body Controls -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="16dp">

            <ImageButton
                android:id="@+id/timer_pause_resume"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/rounded_background_orange"
                android:src="@drawable/ic_pause"
                android:contentDescription="Pause/Resume"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:layout_marginEnd="6dp" />

            <ImageButton
                android:id="@+id/timer_cancel"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/rounded_background"
                android:src="@android:drawable/ic_delete"
                android:contentDescription="Cancel"
                android:padding="8dp"
                android:scaleType="fitCenter" />
        </LinearLayout>
    </LinearLayout>
    </LinearLayout>

    <!-- Slot Badge (1, 2, or 3) - Top-left corner, overlapping -->
    <TextView
        android:id="@+id/timer_slot_badge"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="0dp"
        android:layout_marginTop="0dp"
        android:background="@drawable/slot_badge_background"
        android:gravity="center"
        android:text="1"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:elevation="16dp" />

</FrameLayout>
