<?xml version="1.0" encoding="utf-8"?>
<!--
  Subtle "Trial: N days left" pill, matching CalendarReauthPill styling
  (dark glass + amber border + amber warning icon + amber label).
  Positioned bottom-left of the dashboard but offset enough to clear
  the native sidebar (~80dp wide) and the sidebar's pin/lock chips.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/trialChipRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom|start"
    android:layout_marginStart="90dp"
    android:layout_marginBottom="16dp">

    <LinearLayout
        android:id="@+id/trialChipBody"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="13dp"
        android:paddingEnd="13dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:background="@drawable/bg_trial_chip"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_weather_warning"
            android:tint="#FFA800"
            android:scaleType="fitCenter"
            android:contentDescription="Trial expiring" />

        <View
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/textTrialChipDays"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Trial: 5 days left"
            android:textSize="15sp"
            android:textColor="#FFA800"
            android:includeFontPadding="false" />

    </LinearLayout>

</FrameLayout>
