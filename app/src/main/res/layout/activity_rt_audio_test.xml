<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#101216">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="RT Audio Test — Gemini Live"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/rtStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Idle"
        android:textColor="#FFAA00"
        android:textSize="16sp" />

    <Button
        android:id="@+id/rtToggle"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:text="Start"
        android:textAllCaps="false"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/rtUsage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:padding="8dp"
        android:background="#14201A"
        android:fontFamily="monospace"
        android:textColor="#7FE0A0"
        android:textSize="12sp"
        android:text="Usage: —" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Log"
        android:textColor="#8899AA"
        android:textSize="12sp" />

    <ScrollView
        android:id="@+id/rtLogScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:background="#181B20"
        android:padding="8dp">

        <TextView
            android:id="@+id/rtLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="#B8C2CC"
            android:textSize="11sp"
            android:text="" />
    </ScrollView>

</LinearLayout>
