<?xml version="1.0" encoding="utf-8"?>
<!-- Update-details modal. Triggered from the Control Center "Software Update"
     card. Shows manifest-supplied title + description; falls back to generic
     copy when the manifest doesn't carry release notes. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_background"
    android:padding="24dp">

    <TextView
        android:id="@+id/updateModalTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/updateModalVersion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Updating to v—"
        android:textSize="12sp"
        android:textColor="@color/text_hint"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="240dp"
        android:layout_marginBottom="20dp">

        <TextView
            android:id="@+id/updateModalDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:lineSpacingExtra="3dp" />

    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/updateModalDismiss"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Dismiss"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:textAllCaps="false"
            android:background="@drawable/button_border"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/updateModalLater"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Later"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:textAllCaps="false"
            android:background="@drawable/button_border"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/updateModalInstall"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Install Now"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:background="@drawable/button_primary"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:layout_marginStart="4dp" />

    </LinearLayout>

</LinearLayout>
