<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/settings_backdrop"
    android:clickable="true"
    android:focusable="false"
    tools:context=".halite.settings.SettingsActivity">

    <!-- Modal container - margins set programmatically for responsive layout -->
    <androidx.cardview.widget.CardView
        android:id="@+id/settingsContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_marginHorizontal="144dp"
        android:layout_marginVertical="32dp"
        android:clickable="true"
        android:focusable="false"
        app:cardCornerRadius="@dimen/settings_modal_corner_radius"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/settings_container_bg">

        <!-- Fragment container for settings screens -->
        <FrameLayout
            android:id="@+id/settingsFragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </androidx.cardview.widget.CardView>

</FrameLayout>
