<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom-anchored status banner shown during an update download / install.
     Persistent (no buttons) — purely informational so the user knows
     something is happening even when they're not in Control Center. Auto-
     dismisses when the update state transitions out of in-progress. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/dialog_background"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:gravity="center_vertical"
    android:elevation="8dp">

    <ProgressBar
        android:id="@+id/updateStatusSpinner"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:indeterminate="true"
        android:layout_marginEnd="10dp" />

    <TextView
        android:id="@+id/updateStatusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="@color/text_primary"
        android:layout_marginEnd="12dp" />

    <!-- Dismiss pill — hides the banner but doesn't cancel the underlying
         download/install. Cancellation is detected automatically via
         the PackageInstaller status callback. D-pad focusable; the
         status banner claims d-pad while visible (see
         DashieUpdateController.handleStatusBannerDpadKey). -->
    <Button
        android:id="@+id/updateStatusDismiss"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:minWidth="70dp"
        android:text="Dismiss"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:textAllCaps="false"
        android:background="@drawable/button_border"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:focusable="true"
        android:focusableInTouchMode="false" />

</LinearLayout>
