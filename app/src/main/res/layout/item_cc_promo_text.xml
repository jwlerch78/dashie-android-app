<?xml version="1.0" encoding="utf-8"?>
<!-- Full-width promo row. The message + optional dismiss "✕" sit in a
     centered wrap-content box (ccPromoBox); the box background is applied
     programmatically (themed) only for dismissable promos. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:id="@+id/ccPromoBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/ccPromoText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp"
            android:gravity="center"
            tools:text="Try Dashie's Calendar, AI &amp; more." />

        <!-- Dismiss "✕" — sits just right of the message; only shown for the
             free-trial promo (dismissAction set). -->
        <TextView
            android:id="@+id/ccPromoDismiss"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✕"
            android:textColor="@color/settings_text_value"
            android:textSize="13sp"
            android:paddingStart="10dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:clickable="true"
            android:focusable="false"
            android:visibility="gone"
            android:background="?attr/selectableItemBackground"
            tools:visibility="visible" />
    </LinearLayout>

</FrameLayout>
