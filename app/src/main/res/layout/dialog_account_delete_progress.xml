<?xml version="1.0" encoding="utf-8"?>
<!--
  Non-cancellable progress dialog shown during account deletion. Native
  AlertDialog so it renders above the Control Center overlay (web modals
  are stuck below CC's window). Mirrors the orange-spinner styling of
  DashieModal.progress() on web.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_background"
    android:padding="32dp"
    android:gravity="center">

    <ProgressBar
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:indeterminate="true"
        android:indeterminateTint="#FFAA00"
        android:layout_marginBottom="20dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Deleting account…"
        android:textSize="18sp"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="This may take a few seconds."
        android:textSize="13sp"
        android:textColor="@color/text_secondary" />

</LinearLayout>
