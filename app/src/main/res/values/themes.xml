<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Main app theme - follows system light/dark mode -->
    <style name="Theme.Dashie" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/dashie_orange</item>
        <item name="colorPrimaryVariant">@color/dashie_orange_dark</item>
        <item name="colorAccent">@color/dashie_orange</item>
        <item name="android:colorAccent">@color/dashie_orange</item>
        <item name="colorControlActivated">@color/dashie_orange</item>
        <item name="android:colorControlActivated">@color/dashie_orange</item>
        <item name="colorControlHighlight">@color/dashie_orange_light</item>
        <item name="android:colorControlHighlight">@color/dashie_orange_light</item>
    </style>

    <!-- Dashie Default theme with orange accent - follows system light/dark mode -->
    <style name="Theme.Dashie.Default" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/dashie_orange</item>
        <item name="colorAccent">@color/dashie_orange</item>
        <item name="android:colorAccent">@color/dashie_orange</item>
        <item name="colorControlActivated">@color/dashie_orange</item>
        <item name="android:colorControlActivated">@color/dashie_orange</item>
        <item name="colorControlHighlight">@color/dashie_orange_light</item>
        <item name="android:colorControlHighlight">@color/dashie_orange_light</item>
    </style>

    <!-- Dialog theme - constrained width, modal appearance -->
    <style name="Theme.Dashie.Dialog" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
        <item name="colorPrimary">@color/dashie_orange</item>
        <item name="colorAccent">@color/dashie_orange</item>
        <item name="android:colorAccent">@color/dashie_orange</item>
        <item name="colorControlActivated">@color/dashie_orange</item>
        <item name="android:colorControlActivated">@color/dashie_orange</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Dashie.Button.Dialog</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Dashie.Button.Dialog</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Dashie.Button.Dialog.Text</item>
    </style>

    <!-- TimePicker theme for sleep settings -->
    <style name="Theme.Dashie.TimePicker" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="colorPrimary">@color/dashie_orange</item>
        <item name="colorAccent">@color/dashie_orange</item>
        <item name="android:colorAccent">@color/dashie_orange</item>
        <item name="colorControlActivated">@color/dashie_orange</item>
        <item name="android:colorControlActivated">@color/dashie_orange</item>
    </style>

    <!-- Dialog button styles -->
    <style name="Widget.Dashie.Button.Dialog" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/dashie_orange</item>
    </style>

    <style name="Widget.Dashie.Button.Dialog.Text" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Splash screen theme - follows system light/dark mode -->
    <!-- Traditional splash using window background - works on ALL Android versions -->
    <style name="Theme.Dashie.Splash" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Use drawable as window background - shows immediately -->
        <item name="android:windowBackground">@drawable/splash_background</item>

        <!-- Prevent overdraw -->
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>

        <!-- Android 12+ Splash Screen API attributes (for newer devices) -->
        <item name="android:windowSplashScreenBackground">@color/orange</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenAnimationDuration">1000</item>
    </style>

    <!-- Settings Activity theme - iOS-style modal appearance -->
    <style name="Theme.Dashie.Settings" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Translucent background for modal effect -->
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>

        <!-- No action bar -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <!-- Orange accent -->
        <item name="colorPrimary">@color/dashie_orange</item>
        <item name="colorAccent">@color/dashie_orange</item>
        <item name="android:colorAccent">@color/dashie_orange</item>
        <item name="colorControlActivated">@color/dashie_orange</item>
        <item name="android:colorControlActivated">@color/dashie_orange</item>

        <!-- Switch styling -->
        <item name="colorSwitchThumbNormal">@color/settings_toggle_thumb</item>
        <item name="android:colorControlHighlight">@color/settings_focus_highlight</item>

        <!-- Animation -->
        <item name="android:windowAnimationStyle">@style/SettingsWindowAnimation</item>
    </style>

    <!-- Settings window animations — none; container slides programmatically -->
    <style name="SettingsWindowAnimation">
        <item name="android:windowEnterAnimation">@null</item>
        <item name="android:windowExitAnimation">@null</item>
    </style>

    <!-- Settings Switch style -->
    <style name="Widget.Dashie.Switch" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="trackTint">@color/settings_toggle_track_selector</item>
        <item name="thumbTint">@color/settings_toggle_thumb</item>
    </style>

</resources>
