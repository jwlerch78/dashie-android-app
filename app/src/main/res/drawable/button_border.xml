<?xml version="1.0" encoding="utf-8"?>
<!--
    Secondary button. On d-pad focus, an orange outline ring is drawn in a
    3dp inset gap around the button edge (matching the kiosk onboarding CSS
    pattern: outline + outline-offset). The button's fill is unchanged on
    focus, so the ring is the sole focus indicator and never collides
    visually with an adjacent primary (orange-fill) button.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <layer-list>
            <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/button_border_pressed_bg" />
                    <stroke android:width="1dp" android:color="@color/button_border_stroke" />
                    <corners android:radius="4dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Focused state (D-pad navigation): orange outline ring + default fill -->
    <item android:state_focused="true">
        <layer-list>
            <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="1dp" android:color="@color/button_border_stroke" />
                    <corners android:radius="4dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="2dp" android:color="@color/dashie_orange" />
                    <corners android:radius="7dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Default state -->
    <item>
        <layer-list>
            <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="1dp" android:color="@color/button_border_stroke" />
                    <corners android:radius="4dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
