<?xml version="1.0" encoding="utf-8"?>
<!--
  Primary-action button. The NAME is Dashie legacy — this is "the brand's primary button",
  not "an orange button". Its three states reference colour resources so the chickadee*
  flavors rebrand it by overriding those three in src/chickadeeBrand/res/values/colors.xml,
  exactly the way `orange` is redirected there rather than copying the theme files.

  Do not put hexes back in here: this selector is shared by every screen with a primary
  button, so a per-brand COPY of the file would be one more place to forget one.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_button_pressed" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_button_focused" />
            <corners android:radius="8dp" />
            <stroke android:width="4dp" android:color="#FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_button" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
