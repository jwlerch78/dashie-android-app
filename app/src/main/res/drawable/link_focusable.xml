<?xml version="1.0" encoding="utf-8"?>
<!-- Background drawable for clickable text links with D-pad focus support -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/dashie_orange_light" />
            <stroke android:width="2dp" android:color="@color/dashie_orange" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <!-- Focused state (for D-pad navigation) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/dashie_orange_light" />
            <stroke android:width="2dp" android:color="@color/dashie_orange" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <!-- Default state (transparent) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
