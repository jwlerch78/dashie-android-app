<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary gray button. Mirrors button_orange.xml states (pressed/focused/
     default) so it reads as a lesser action beside an orange primary, with a
     white focus stroke for D-pad visibility on TV. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#616161" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#9E9E9E" />
            <corners android:radius="8dp" />
            <stroke android:width="4dp" android:color="#FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#757575" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
