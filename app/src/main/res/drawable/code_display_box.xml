<?xml version="1.0" encoding="utf-8"?>
<!--
  Background for the pairing code display box on the photo upload dialog.
  Mirrors the boxed code style used by the JS auth-pairing screen
  (Sign in to Dashie with Google).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#F5F5F7" />
    <stroke android:width="1dp" android:color="#E5E5EA" />
    <corners android:radius="12dp" />
</shape>
