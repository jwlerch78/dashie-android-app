<?xml version="1.0" encoding="utf-8"?>
<!-- Focus-aware background for sidebar menu items.
     Shows orange accent border + highlight when focused (D-pad navigation).
     Transparent default so sidebar background color shows through. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state (D-pad navigation) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/settings_focus_highlight" />
            <stroke
                android:width="3dp"
                android:color="@color/settings_accent" />
        </shape>
    </item>
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/settings_focus_highlight" />
        </shape>
    </item>
    <!-- Default state (transparent) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
