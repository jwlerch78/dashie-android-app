<?xml version="1.0" encoding="utf-8"?>
<!--
  Apple iCloud credentials dialog. Two-input variant of dialog_input.xml,
  shown to phones (and to tablets that hit "Continue here anyway"). Button
  format matches dialog_input.xml so this dialog visually matches the rest
  of the native settings dialogs.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_background"
    android:padding="24dp">

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Connect Apple iCloud"
        android:textSize="20sp"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <!-- Description -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Apple requires an app-specific password — your normal iCloud password will not work. Generate one at appleid.apple.com → Sign-In and Security → App-Specific Passwords."
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:lineSpacingExtra="2dp"
        android:layout_marginBottom="20dp" />

    <!-- Email label -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Apple ID (email)"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/appleEmailInput"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="you@icloud.com"
        android:textSize="16sp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint"
        android:background="@drawable/edit_text_background"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:inputType="textEmailAddress"
        android:autofillHints="emailAddress"
        android:layout_marginBottom="16dp" />

    <!-- Password label -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="App-Specific Password"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/applePasswordInput"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="xxxx-xxxx-xxxx-xxxx"
        android:textSize="16sp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint"
        android:background="@drawable/edit_text_background"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:fontFamily="monospace"
        android:inputType="textPassword" />

    <!-- Buttons row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="24dp">

        <Button
            android:id="@+id/buttonNegative"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Cancel"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:textAllCaps="false"
            android:background="@drawable/button_border"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/buttonPositive"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Connect"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:background="@drawable/button_primary"
            android:layout_marginStart="8dp" />

    </LinearLayout>

</LinearLayout>
